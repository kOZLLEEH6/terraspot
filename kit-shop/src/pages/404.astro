---
import Base from '../layouts/Base.astro';
---

<Base title="Seite nicht gefunden" noindex>
  <section class="missing wrap">
    <svg class="sleepy" viewBox="0 0 120 96" aria-hidden="true">
      <rect x="26" y="6" width="16" height="12" rx="4" fill="var(--pink)"></rect>
      <rect x="78" y="6" width="16" height="12" rx="4" fill="var(--pink)"></rect>
      <rect x="6" y="14" width="108" height="78" rx="22" fill="#f3f3ee" stroke="rgb(13 21 18 / 0.12)"></rect>
      <rect x="24" y="30" width="72" height="36" rx="7" fill="#090c0e"></rect>
      <rect x="36" y="50" width="18" height="3" rx="1.5" fill="var(--oled)"></rect>
      <rect x="66" y="50" width="18" height="3" rx="1.5" fill="var(--oled)"></rect>
      <text x="84" y="44" fill="var(--oled)" font-family="var(--font-mono)" font-size="9">z</text>
    </svg>
    <p class="label">Fehler 404</p>
    <h1>Hier ist nichts verlötet.</h1>
    <p class="lead">Die Seite gibt es nicht. Vielleicht ein kalter Lötpunkt im Link.</p>
    <a class="btn btn--ink" href="/">Zur Startseite</a>
  </section>
</Base>

<style>
  .missing {
    min-height: 80svh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 24px;
    padding-block: calc(var(--header-h) + 64px) 96px;
  }
  .sleepy {
    width: 120px;
  }
  .missing h1 {
    font-size: var(--t-h2);
  }
</style>
