---
import Logo from './Logo.astro';
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <Logo />
    <nav class="nav" aria-label="Hauptnavigation">
      <a href="/#bausaetze">Bausätze</a>
      <a href="/#ablauf" class="hide-sm">So läuft's</a>
      <a href="/#fragen" class="hide-sm">Fragen</a>
    </nav>
    <button class="cart-btn" type="button" data-cart-open aria-haspopup="dialog" aria-controls="cart">
      <span>Korb</span>
      <span class="count num" data-cart-count aria-live="polite">0</span>
      <span class="sr-only">Artikel im Warenkorb</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    transition:
      transform 0.45s var(--ease-out),
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .site-header.is-scrolled {
    background: rgb(238 240 234 / 0.92);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--rule);
  }
  .site-header.is-hidden {
    transform: translateY(-110%);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav {
    margin-left: auto;
    display: flex;
    gap: 4px;
  }
  .nav a {
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 550;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  @media (hover: hover) {
    .nav a:hover {
      background: var(--paper-sunk);
    }
  }
  .cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 42px;
    padding: 0 8px 0 18px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      transform 0.16s var(--ease-out);
  }
  .cart-btn:active {
    transform: scale(0.97);
  }
  @media (hover: hover) {
    .cart-btn:hover {
      border-color: var(--ink);
    }
  }
  .count {
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }
  .count.has-items {
    background: var(--pink);
    color: var(--ink);
  }
  .count.bump {
    animation: bump 0.45s var(--ease-out);
  }
  @keyframes bump {
    30% {
      transform: scale(1.25);
    }
  }
  @media (max-width: 720px) {
    .hide-sm {
      display: none;
    }
    .bar {
      gap: 8px;
    }
    .nav a {
      padding: 10px 10px;
    }
  }
</style>
