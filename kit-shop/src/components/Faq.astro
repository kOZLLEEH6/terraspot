---
import { site, euro } from '../data/site';
import { addons } from '../data/kits';
const loetset = addons.find((a) => a.id === 'loetset')!;

const faqs = [
  {
    q: 'Muss ich löten können?',
    a: 'Nein. Der Grundkurs kommt ganz ohne Löten aus, da wird alles gesteckt. Beim Kumpel sind es 24 Lötstellen, alles Durchsteck-Bauteile. Die Anleitung zeigt jede einzeln, und auf der Platine sind Übungspads zum Ausprobieren.',
  },
  {
    q: 'Was brauche ich zusätzlich?',
    a: `Einen Computer mit Chrome oder Edge zum Flashen, ein USB-C-Kabel und für die Löt-Bausätze einen Lötkolben. Falls du keinen hast: Das Lötset gibt es für ${euro(loetset.price)} dazu.`,
  },
  {
    q: 'Ab welchem Alter geht das?',
    a: 'Ab 14 Jahren. Jüngere schaffen das auch, aber bitte mit einem Erwachsenen daneben. Lötkolben werden heiß und die Teile sind klein. Die Bausätze sind Lernmaterial und kein Spielzeug.',
  },
  {
    q: 'Was, wenn etwas nicht funktioniert?',
    a: 'Schau zuerst in die Fehlersuche der Anleitung, die deckt die häufigsten Lötfehler ab. Hilft das nicht, schick uns ein Foto deiner Platine. Ist ein Teil defekt, bekommst du kostenlos Ersatz.',
  },
  {
    q: 'Wie schnell kommt das Paket?',
    a: `Wir verschicken innerhalb von ${site.shipping.dispatch} mit DHL nach Deutschland und Österreich. Ab ${euro(site.shipping.freeFrom)} ist der Versand kostenlos.`,
  },
  {
    q: 'Darf ich den Code ändern?',
    a: 'Unbedingt, dafür ist er da. Der Code steht unter MIT-Lizenz offen im Netz. Du bearbeitest ihn mit der Arduino IDE oder PlatformIO und kannst jederzeit zur Original-Firmware zurück.',
  },
];
---

<section class="faq" id="fragen" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="intro">
      <div class="section-head">
        <p class="label">Fragen</p>
        <h2 id="faq-title" data-reveal-title>Was oft gefragt wird.</h2>
      </div>
      <p class="contact">
        Noch was offen? Schreib an{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>. Wir antworten meistens am selben Tag.
      </p>
    </div>
    <div class="list">
      {
        faqs.map((f, i) => (
          <details name="faq" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="icon" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: clamp(96px, 12vw, 180px);
    border-top: 1px solid var(--rule);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .intro {
    display: grid;
    gap: 28px;
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .intro h2 {
    font-size: var(--t-h2);
  }
  .contact {
    color: var(--ink-soft);
    max-width: 30em;
  }
  .contact a {
    color: var(--ink);
    font-weight: 600;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .list {
    border-top: 1px solid var(--ink);
  }
  details {
    border-bottom: 1px solid var(--rule-strong);
    interpolate-size: allow-keywords;
  }
  details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }
  details[open]::details-content {
    height: auto;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 700;
    font-stretch: 112%;
    letter-spacing: -0.015em;
    line-height: 1.2;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .icon {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--rule-strong);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.35s var(--ease-out);
  }
  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }
  .icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.35s var(--ease-out);
  }
  details[open] .icon {
    background: var(--pink);
    border-color: var(--pink);
  }
  details[open] .icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }
  @media (hover: hover) {
    summary:hover .icon {
      border-color: var(--ink);
    }
  }
  .answer {
    padding: 0 56px 28px 0;
    color: var(--ink-soft);
    max-width: 40em;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      position: static;
    }
    .answer {
      padding-right: 0;
    }
  }
</style>
