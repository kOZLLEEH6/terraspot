---
import { site, euro } from '../data/site';
import { addons } from '../data/kits';
const loetset = addons.find((a) => a.id === 'loetset')!;
---

<dialog id="cart" class="cart" aria-labelledby="cart-title" data-cart>
  <div class="cart-panel" data-cart-panel>
    <header class="cart-head">
      <h2 id="cart-title">Dein Korb</h2>
      <button class="icon-btn" type="button" data-cart-close aria-label="Korb schließen">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <div class="ship" data-ship>
      <p class="ship-text" data-ship-text>Ab {euro(site.shipping.freeFrom)} versandkostenfrei</p>
      <div class="ship-bar" aria-hidden="true"><span data-ship-bar></span></div>
    </div>

    <ul class="cart-items" data-cart-items aria-live="polite"></ul>

    <div class="cart-empty" data-cart-empty>
      <p>Noch leer. Der Kumpel hätte gern Gesellschaft.</p>
      <a href="/#bausaetze" class="btn btn--line btn--sm" data-cart-close>Bausätze ansehen</a>
    </div>

    <div class="upsell" data-upsell hidden>
      <p><strong>Noch kein Lötkolben?</strong> Das {loetset.name} hat alles, was du zum Löten brauchst.</p>
      <button type="button" class="btn btn--line btn--sm" data-add="loetset" data-no-open>
        Dazulegen <span class="price">{euro(loetset.price)}</span>
      </button>
    </div>

    <footer class="cart-foot" data-cart-foot>
      <dl class="sum">
        <div><dt>Zwischensumme</dt><dd class="num" data-subtotal>0 €</dd></div>
        <div><dt>Versand nach DE/AT</dt><dd class="num" data-shipping>{euro(site.shipping.flat)}</dd></div>
        <div class="total"><dt>Gesamt</dt><dd class="num" data-total>0 €</dd></div>
      </dl>
      <p class="vat">Alle Preise inkl. MwSt. Versand in {site.shipping.dispatch}.</p>
      <button class="btn btn--pink checkout" type="button" data-checkout>Zur Kasse</button>
      <p class="checkout-msg" data-checkout-msg role="status" hidden></p>
    </footer>
  </div>
</dialog>

<style is:global>
  .cart {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(440px, 100vw);
    max-width: 100vw;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  .cart::backdrop {
    background: rgb(13 21 18 / 0.35);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .cart.is-open::backdrop {
    opacity: 1;
  }
  .cart-panel {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--paper-raised);
    box-shadow: -24px 0 60px rgb(13 21 18 / 0.14);
    padding: calc(env(safe-area-inset-top, 0px) + 20px) 24px calc(env(safe-area-inset-bottom, 0px) + 24px);
    transform: translateX(100%);
    transition: transform 0.45s var(--ease-out);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .cart.is-open .cart-panel {
    transform: none;
  }
  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16px;
  }
  .cart-head h2 {
    font-size: 1.625rem;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    transition: transform 0.16s var(--ease-out);
  }
  .icon-btn:active {
    transform: scale(0.94);
  }
  .ship {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border-radius: var(--radius);
    background: var(--paper-sunk);
  }
  .ship-text {
    font-size: 0.875rem;
  }
  .ship-bar {
    height: 4px;
    border-radius: 2px;
    background: rgb(13 21 18 / 0.1);
    overflow: hidden;
  }
  .ship-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--ink);
    transition:
      width 0.5s var(--ease-out),
      background-color 0.3s ease;
  }
  .ship.is-free .ship-bar span {
    background: var(--pink);
  }
  .cart-items {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 6px 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--rule);
  }
  .cart-item .name {
    font-weight: 650;
    line-height: 1.3;
  }
  .cart-item .unit {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .cart-item .line {
    grid-row: 1;
    grid-column: 2;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .cart-item .controls {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
  }
  .stepper button {
    width: 36px;
    height: 34px;
    border: 0;
    background: none;
    font-size: 1.1rem;
    cursor: pointer;
    border-radius: 999px;
  }
  .stepper output {
    min-width: 2ch;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .remove {
    border: 0;
    background: none;
    padding: 6px 0;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .cart-empty {
    display: grid;
    justify-items: start;
    gap: 16px;
    padding: 28px 0;
    color: var(--ink-soft);
  }
  .upsell {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 20px;
    padding: 16px;
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius);
    font-size: 0.9375rem;
  }
  .cart-foot {
    margin-top: auto;
    padding-top: 24px;
    display: grid;
    gap: 12px;
  }
  .sum {
    display: grid;
    gap: 6px;
    margin: 0;
  }
  .sum div {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
  }
  .sum dt {
    color: var(--ink-soft);
  }
  .sum dd {
    margin: 0;
  }
  .sum .total {
    padding-top: 10px;
    margin-top: 4px;
    border-top: 1px solid var(--ink);
    font-size: 1.125rem;
    font-weight: 700;
  }
  .sum .total dt {
    color: var(--ink);
  }
  .vat {
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
  .checkout {
    width: 100%;
  }
  .checkout-msg {
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--pink-soft);
    font-size: 0.875rem;
  }
  .cart.is-empty .cart-foot,
  .cart.is-empty .ship {
    display: none;
  }
</style>
