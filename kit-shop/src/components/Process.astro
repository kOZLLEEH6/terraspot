---
// Ablauf in vier Schritten. Links läuft eine Leiterbahn (mit 45°-Knicken wie auf
// einer echten Platine), die sich beim Scrollen bis zum aktuellen Schritt zeichnet.
const steps = [
  {
    title: 'Auspacken',
    time: '10 Min.',
    text: 'Alle Teile liegen sortiert in beschrifteten Tüten. Leg sie neben die Stückliste und hak sie ab. Fehlt etwas, schicken wir es kostenlos nach.',
  },
  {
    title: 'Löten',
    time: '60 bis 90 Min.',
    text: '24 Lötstellen, alle groß und gut erreichbar. Die Anleitung zeigt jede einzelne mit Foto. Noch nie gelötet? Auf der Platine sind Übungspads zum Warmwerden.',
  },
  {
    title: 'Flashen',
    time: '2 Min.',
    text: 'USB-C rein, Browser auf, Knopf drücken. Die Firmware kommt direkt aus Chrome oder Edge auf den ESP32. Installieren musst du nichts.',
    terminal: true,
  },
  {
    title: 'Anpassen',
    time: 'so lange du willst',
    text: 'Der Code ist offen. Neue Gesichter, Wetter, Uhrzeit oder eine Erinnerung zum Wassertrinken. In der Arduino IDE oder mit PlatformIO.',
    link: true,
  },
];
---

<section class="process" id="ablauf" aria-labelledby="ablauf-title">
  <div class="wrap grid">
    <div class="intro">
      <div class="section-head">
        <p class="label">Ablauf</p>
        <h2 id="ablauf-title" data-reveal-title>Vom Karton zum Kumpel.</h2>
      </div>
      <p class="lead">
        Vier Schritte und eine Anleitung mit Fotos zu jedem Handgriff. Vorwissen brauchst du keins, nur einen
        freien Abend.
      </p>
    </div>

    <ol class="steps" data-steps>
      <svg class="trace" data-trace aria-hidden="true">
        <path class="trace-base" data-trace-base></path>
        <path class="trace-live" data-trace-live></path>
        <circle class="trace-tip" data-trace-tip r="5"></circle>
      </svg>
      {
        steps.map((s, i) => (
          <li class="step" data-step>
            <span class="via" data-via aria-hidden="true" />
            <div class="step-body">
              <p class="label step-meta">
                <span>Schritt {i + 1}</span>
                <span class="time">{s.time}</span>
              </p>
              <h3>{s.title}</h3>
              <p class="step-text">{s.text}</p>
              {s.terminal && (
                <div class="terminal" data-terminal>
                  <div class="term-bar">
                    <span class="lamp" />
                    <span class="lamp" />
                    <span class="lamp" />
                    <span class="term-title">kumpel-flasher · Chrome</span>
                  </div>
                  <div class="term-body" data-term-body role="img" aria-label="Beispielausgabe beim Flashen: Verbindung, Chip erkannt, Firmware geschrieben, Kumpel läuft">
                    <span class="term-line">Connecting....</span>
                    <span class="term-line">Chip is ESP32-C3 (QFN32) (revision v0.4)</span>
                    <span class="term-line">Features: WiFi, BLE, Embedded Flash 4MB</span>
                    <span class="term-line" data-term-progress>Writing at 0x000f4000... (100 %)</span>
                    <span class="term-line">Hash of data verified.</span>
                    <span class="term-line">Hard resetting via RTS pin...</span>
                    <span class="term-line term-ok">Kumpel v1.0 läuft. Sag hallo!</span>
                  </div>
                </div>
              )}
              {s.link && (
                <a class="step-link" href="#code">
                  Probier's gleich hier aus
                  <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(96px, 14vw, 200px);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .intro {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    display: grid;
    gap: 28px;
  }
  .intro h2 {
    font-size: var(--t-h2);
  }
  .steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0 0 0 64px;
    display: grid;
    gap: clamp(56px, 8vw, 104px);
  }
  .trace {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .trace-base {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .trace-live {
    fill: none;
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .trace-tip {
    fill: var(--pink);
    stroke: var(--ink);
    stroke-width: 1.5;
    opacity: 0;
  }
  .step {
    position: relative;
    display: grid;
    min-width: 0;
  }
  .via {
    position: absolute;
    left: -64px;
    top: 6px;
    width: 22px;
    height: 22px;
    margin-left: 1px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--rule-strong);
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.4s var(--ease-out);
  }
  .via::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--rule-strong);
    transition: border-color 0.3s ease;
  }
  .step.is-on .via {
    border-color: var(--ink);
    background: var(--gold);
    transform: scale(1.1);
  }
  .step.is-on .via::after {
    border-color: var(--ink);
  }
  .step-body {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .step-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--ink-faint);
    transition: color 0.3s ease;
  }
  .step.is-on .step-meta {
    color: var(--ink-soft);
  }
  .step-meta .time::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 1px;
    margin-right: 12px;
    vertical-align: middle;
    background: currentColor;
  }
  .step h3 {
    font-size: var(--t-h3);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem);
  }
  .step-text {
    max-width: 36em;
    color: var(--ink-soft);
  }

  .terminal {
    margin-top: 10px;
    border-radius: 10px;
    background: var(--pcb-deep);
    color: var(--silk);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgb(6 37 25 / 0.55);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--pcb-rule);
  }
  .lamp {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(233 242 236 / 0.18);
  }
  .term-title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--silk-soft);
  }
  .term-body {
    display: grid;
    margin: 0;
    padding: 18px 20px 22px;
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 0.62rem + 0.25vw, 0.8125rem);
    line-height: 1.75;
    overflow-x: auto;
  }
  .term-line {
    display: block;
    min-height: 1.75em;
    white-space: pre-wrap;
    color: var(--silk-soft);
  }
  .term-ok {
    color: var(--pink);
  }
  :global(html.js) .term-line.is-pending {
    visibility: hidden;
  }
  .term-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: var(--pink);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .step-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-weight: 650;
    text-decoration: none;
    border-bottom: 2px solid var(--pink);
    padding-bottom: 2px;
  }
  .step-link svg {
    transition: transform 0.25s var(--ease-out);
  }
  @media (hover: hover) {
    .step-link:hover svg {
      transform: translateX(4px);
    }
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      position: static;
    }
    .steps {
      padding-left: 48px;
    }
    .trace {
      width: 48px;
    }
    .via {
      left: -48px;
    }
  }
</style>
