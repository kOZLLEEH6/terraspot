---
// Produkt-Illustrationen als SVG, im selben Stil wie das 3D-Modell.
interface Props {
  kit: string;
  class?: string;
}
const { kit, class: className } = Astro.props;
const uid = `art-${kit}`;

// 4 × 7 Pixel-Ziffern für die Pixeluhr
const DIGITS: Record<string, string[]> = {
  '1': ['0010', '0110', '0010', '0010', '0010', '0010', '0111'],
  '2': ['0110', '1001', '0001', '0010', '0100', '1000', '1111'],
  '3': ['1110', '0001', '0001', '0110', '0001', '0001', '1110'],
  '4': ['0010', '0110', '1010', '1010', '1111', '0010', '0010'],
  ':': ['0', '0', '1', '0', '1', '0', '0'],
};
const lit = new Set<string>();
let col = 4;
for (const ch of '12:34') {
  const g = DIGITS[ch];
  g.forEach((row, r) => [...row].forEach((b, c) => b === '1' && lit.add(`${col + c},${r}`)));
  col += g[0].length + (ch === ':' || '12:34'.indexOf(ch) === 1 ? 2 : 1);
}
const matrix: { x: number; y: number; on: boolean }[] = [];
for (let y = 0; y < 8; y++) for (let x = 0; x < 32; x++) matrix.push({ x, y, on: lit.has(`${x},${y}`) });

// Steckbrett-Löcher
const holes: { x: number; y: number }[] = [];
for (let c = 0; c < 29; c++) {
  for (const y of [100, 110, 120, 130, 140, 168, 178, 188, 198, 208]) holes.push({ x: 62 + c * 10, y });
}
const rails: { x: number; y: number }[] = [];
for (let c = 0; c < 25; c++) {
  if (c % 5 === 4) continue;
  for (const y of [78, 86, 230, 238]) rails.push({ x: 72 + c * 11, y });
}
---

<svg class:list={['kit-art', className]} viewBox="0 0 400 300" role="img" aria-label={`Illustration ${kit}`}>
  <defs>
    <filter id={`${uid}-blur`} x="-20%" y="-50%" width="140%" height="200%">
      <feGaussianBlur stdDeviation="7"></feGaussianBlur>
    </filter>
    <filter id={`${uid}-glow`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="3" result="b"></feGaussianBlur>
      <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
    </filter>
    <linearGradient id={`${uid}-shell`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f7f7f3"></stop>
      <stop offset="1" stop-color="#e5e6df"></stop>
    </linearGradient>
  </defs>

  {
    kit === 'kumpel' && (
      <g>
        <ellipse cx="200" cy="258" rx="126" ry="13" fill="rgb(13 21 18 / 0.16)" filter={`url(#${uid}-blur)`} />
        <rect x="128" y="50" width="36" height="28" rx="9" fill="#ff8db7" />
        <rect x="236" y="50" width="36" height="28" rx="9" fill="#ff8db7" />
        <rect x="86" y="64" width="228" height="180" rx="46" fill={`url(#${uid}-shell)`} />
        <rect x="86.5" y="64.5" width="227" height="179" rx="45.5" fill="none" stroke="rgb(13 21 18 / 0.08)" />
        <rect x="132" y="100" width="136" height="80" rx="15" fill="#090c0e" />
        <g fill="#d4f6ff" filter={`url(#${uid}-glow)`} class="art-eyes">
          <rect x="153" y="120" width="40" height="40" rx="10" />
          <rect x="207" y="120" width="40" height="40" rx="10" />
        </g>
        <g fill="#4a514d">
          <circle cx="187" cy="214" r="3" />
          <circle cx="200" cy="214" r="3" />
          <circle cx="213" cy="214" r="3" />
        </g>
      </g>
    )
  }

  {
    kit === 'grundkurs' && (
      <g>
        <ellipse cx="200" cy="262" rx="160" ry="10" fill="rgb(13 21 18 / 0.14)" filter={`url(#${uid}-blur)`} />
        <rect x="44" y="64" width="312" height="190" rx="10" fill="#f7f5ee" stroke="rgb(13 21 18 / 0.12)" />
        <line x1="62" y1="72" x2="338" y2="72" stroke="#e0565b" stroke-width="2" />
        <line x1="62" y1="92" x2="338" y2="92" stroke="#3d6fd6" stroke-width="2" />
        <line x1="62" y1="224" x2="338" y2="224" stroke="#e0565b" stroke-width="2" />
        <line x1="62" y1="244" x2="338" y2="244" stroke="#3d6fd6" stroke-width="2" />
        <rect x="52" y="150" width="296" height="12" fill="#ebe8df" />
        <g fill="#c9c4b6">
          {holes.map((h) => (
            <rect x={h.x - 2} y={h.y - 2} width="4" height="4" rx="1" />
          ))}
          {rails.map((h) => (
            <rect x={h.x - 2} y={h.y - 2} width="4" height="4" rx="1" />
          ))}
        </g>
        <g>
          <rect x="168" y="112" width="150" height="84" rx="4" fill="#15181b" />
          <rect x="250" y="122" width="58" height="64" rx="3" fill="#c7cbd0" />
          <rect x="256" y="128" width="46" height="52" rx="2" fill="#b3b8be" />
          <rect x="160" y="140" width="18" height="28" rx="3" fill="#c7cbd0" />
          <rect x="196" y="140" width="20" height="20" rx="2" fill="#2d3135" />
          <g fill="#dcb45c">
            {Array.from({ length: 12 }, (_, i) => (
              <circle cx={188 + i * 10} cy="118" r="2.4" />
            ))}
            {Array.from({ length: 12 }, (_, i) => (
              <circle cx={188 + i * 10} cy="190" r="2.4" />
            ))}
          </g>
        </g>
        <path d="M92 110 C 92 60, 150 50, 168 72" fill="none" stroke="#ff8db7" stroke-width="5" stroke-linecap="round" />
        <path d="M112 200 C 120 250, 190 262, 220 230" fill="none" stroke="#0d1512" stroke-width="5" stroke-linecap="round" />
        <path d="M72 140 C 40 160, 50 220, 92 236" fill="none" stroke="#3f9c6a" stroke-width="5" stroke-linecap="round" />
        <g>
          <line x1="90" y1="128" x2="90" y2="140" stroke="#9aa0a6" stroke-width="2" />
          <line x1="100" y1="128" x2="100" y2="140" stroke="#9aa0a6" stroke-width="2" />
          <path d="M84 128 v-12 a11 11 0 0 1 22 0 v12 z" fill="#ff8db7" />
          <rect x="82" y="126" width="26" height="5" rx="1" fill="#f06a9b" />
        </g>
        <g>
          <line x1="120" y1="128" x2="120" y2="140" stroke="#9aa0a6" stroke-width="2" />
          <line x1="130" y1="128" x2="130" y2="140" stroke="#9aa0a6" stroke-width="2" />
          <path d="M114 128 v-12 a11 11 0 0 1 22 0 v12 z" fill="#7fd6a4" />
          <rect x="112" y="126" width="26" height="5" rx="1" fill="#5bbd86" />
        </g>
        <g>
          <line x1="72" y1="188" x2="150" y2="188" stroke="#9aa0a6" stroke-width="2" />
          <rect x="94" y="181" width="36" height="14" rx="7" fill="#e6d3a6" />
          <rect x="102" y="181" width="4" height="14" fill="#7a4b2a" />
          <rect x="110" y="181" width="4" height="14" fill="#0d1512" />
          <rect x="118" y="181" width="4" height="14" fill="#e68a2e" />
        </g>
      </g>
    )
  }

  {
    kit === 'wetterfrosch' && (
      <g>
        <ellipse cx="200" cy="262" rx="120" ry="12" fill="rgb(13 21 18 / 0.15)" filter={`url(#${uid}-blur)`} />
        <path d="M150 226 L250 226 L268 258 L132 258 Z" fill="#e3e4dd" />
        <rect x="78" y="40" width="244" height="196" rx="20" fill={`url(#${uid}-shell)`} />
        <rect x="78.5" y="40.5" width="243" height="195" rx="19.5" fill="none" stroke="rgb(13 21 18 / 0.08)" />
        <rect x="100" y="62" width="200" height="140" rx="4" fill="#e7e6df" />
        <text x="116" y="140" fill="#26282a" font-family="var(--font-display)" font-weight="800" font-size="62" style="font-stretch: 112%">
          21°
        </text>
        <text x="118" y="172" fill="#26282a" font-family="var(--font-mono)" font-size="11">
          62 % · 1014 hPa
        </text>
        <text x="118" y="189" fill="#6b6e70" font-family="var(--font-mono)" font-size="10">
          Mi 14:20
        </text>
        <g fill="none" stroke="#26282a" stroke-width="4">
          <circle cx="252" cy="96" r="12" />
          <path d="M236 122 h34 a10 10 0 0 0 0 -20 a14 14 0 0 0 -26 -2 a10 10 0 0 0 -8 22 z" fill="#e7e6df" />
        </g>
        <g transform="translate(262 160)">
          <ellipse cx="0" cy="12" rx="20" ry="13" fill="#26282a" />
          <circle cx="-9" cy="2" r="7" fill="#26282a" />
          <circle cx="9" cy="2" r="7" fill="#26282a" />
          <circle cx="-9" cy="2" r="3" fill="#e7e6df" />
          <circle cx="9" cy="2" r="3" fill="#e7e6df" />
          <path d="M-8 16 q8 6 16 0" stroke="#e7e6df" stroke-width="2.4" fill="none" stroke-linecap="round" />
        </g>
      </g>
    )
  }

  {
    kit === 'pixeluhr' && (
      <g>
        <ellipse cx="200" cy="232" rx="170" ry="12" fill="rgb(13 21 18 / 0.16)" filter={`url(#${uid}-blur)`} />
        <rect x="34" y="96" width="332" height="122" rx="14" fill="#141816" />
        <rect x="34.5" y="96.5" width="331" height="121" rx="13.5" fill="none" stroke="rgb(255 255 255 / 0.06)" />
        <g>
          {matrix.map((d) => (
            <circle
              cx={58.5 + d.x * 9.4}
              cy={124 + d.y * 9.4}
              r="3.3"
              fill={d.on ? '#ff8db7' : '#262c29'}
              filter={d.on ? `url(#${uid}-glow)` : undefined}
            />
          ))}
        </g>
      </g>
    )
  }
</svg>

<style>
  .kit-art {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .art-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: art-blink 6s infinite;
  }
  @keyframes art-blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    95.5% {
      transform: scaleY(0.1);
    }
  }
</style>
