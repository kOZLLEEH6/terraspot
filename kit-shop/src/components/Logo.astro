---
// Bildmarke: der Kumpel von vorne. Die Augen blinzeln ab und zu.
import { site } from '../data/site';

interface Props {
  href?: string;
  class?: string;
}
const { href = '/', class: className } = Astro.props;
---

<a href={href} class:list={['logo', className]} aria-label={`${site.name}, zur Startseite`}>
  <svg class="mark" viewBox="0 0 32 28" aria-hidden="true">
    <rect x="7" y="0.5" width="5" height="5" rx="1.6" fill="var(--pink)"></rect>
    <rect x="20" y="0.5" width="5" height="5" rx="1.6" fill="var(--pink)"></rect>
    <rect x="1" y="4" width="30" height="23.5" rx="7.5" fill="currentColor"></rect>
    <rect x="6" y="9" width="20" height="11.5" rx="2.6" fill="#18211d"></rect>
    <g class="eyes" fill="var(--oled)">
      <rect x="10" y="11.4" width="4.6" height="6.6" rx="1.4"></rect>
      <rect x="17.4" y="11.4" width="4.6" height="6.6" rx="1.4"></rect>
    </g>
  </svg>
  <span class="word">{site.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .mark {
    width: 32px;
    height: 28px;
    flex: none;
  }
  .word {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 1;
    padding-bottom: 2px;
  }
  .eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: logo-blink 7s infinite;
  }
  @keyframes logo-blink {
    0%,
    95%,
    100% {
      transform: scaleY(1);
    }
    96.5% {
      transform: scaleY(0.12);
    }
  }
</style>
